# Cairn local reverse proxy / static file server
# Listens on 127.0.0.1:18080 — cloudflared tunnel points to http://localhost:18080
# Static files are published by deploy/scripts/redeploy-production.sh to /var/www/cairn.
# Copy to /home/pi/cairn-data/Caddyfile and adjust paths if needed.

:18080 {
    # Reverse-proxy API and health routes to Fastify.
    handle /api/* {
        reverse_proxy 127.0.0.1:3100
    }

    handle /health {
        reverse_proxy 127.0.0.1:3100
    }

    # Files that decide which version loads must always be revalidated; only the hashed
    # files under /assets/ are safe to cache for long.
    @shell path /sw.js /registerSW.js /index.html /manifest.webmanifest /today /calendar /notes /threads* /people* /items /input /mirror /watch /params /
    header @shell Cache-Control "no-cache"
    header /assets/* Cache-Control "public, max-age=31536000, immutable"

    # Serve built PWA; fall back to index.html for SPA client-side routes
    # (/today, /threads, /threads/new, /threads/:id, etc.).
    handle {
        root * /var/www/cairn
        try_files {path} /index.html
        file_server
    }
}
